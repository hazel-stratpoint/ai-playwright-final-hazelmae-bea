{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "main/*": ["./main/*"]
    },
    "types": ["node"],
    "outDir": "dist"
  },
  "include": ["main/**/*.ts", "step-definitions/**/*.ts"]
}
